{
  "name": "@revizorro/cli",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "revizorro": "dist/revizorro.cjs" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild bin/revizorro.js --bundle --platform=node --format=cjs --outfile=dist/revizorro.cjs"
  },
  "dependencies": {
    "@revizorro/protocol": "workspace:*",
    "@revizorro/core": "workspace:*",
    "@revizorro/core-adapters": "workspace:*"
  },
  "devDependencies": { "esbuild": "^0.21.5" }
}
