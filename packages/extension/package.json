{
  "name": "revizorro",
  "displayName": "Revizorro",
  "description": "Review what your AI agent wrote before it is committed — a GitHub-PR-grade form over your worktree diff, with inline threads, Ask-agent and approve/request-changes. Nothing is pushed.",
  "publisher": "artk0de",
  "version": "0.0.36",
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "icon.png",
  "license": "MIT",
  "categories": [
    "AI",
    "SCM Providers"
  ],
  "keywords": [
    "code review",
    "ai agent",
    "diff",
    "pre-commit",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/artk0de/revizorro"
  },
  "homepage": "https://github.com/artk0de/revizorro#readme",
  "bugs": {
    "url": "https://github.com/artk0de/revizorro/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "revizorro.toggleViewMode",
        "title": "Revizorro: Toggle Diff View (split/inline)"
      },
      {
        "command": "revizorro.approve",
        "title": "Revizorro: Approve"
      },
      {
        "command": "revizorro.requestChanges",
        "title": "Revizorro: Request changes"
      },
      {
        "command": "revizorro.clarify",
        "title": "Revizorro: Clarify"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs && esbuild media/webview.ts --bundle --format=iife --outfile=media/webview.js",
    "package": "vsce package --no-dependencies -o revizorro.vsix"
  },
  "dependencies": {
    "@revizorro/core": "*",
    "@revizorro/core-adapters": "*",
    "@revizorro/protocol": "*",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.31.0",
    "esbuild": "^0.21.5"
  }
}
